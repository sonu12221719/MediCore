## ASP.NET Core .gitignore

# Build results
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio Code
.vscode/

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
wwwroot/lib/

# Environment & Secrets
appsettings.Development.json
appsettings.Local.json
*.env
.env
.env.*
secrets.json

# Entity Framework Core Migrations (optional - remove if you want to track migrations)
# Migrations/

# Logs
logs/
*.log
*.txt.log

# Publish output
publish/
**/publish/

# Test results
TestResults/
coverage/
*.coverage
*.coveragexml

# Runtime
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker
docker-compose.override.yml

# Azure
.azure/
*.pubxml
*.pubxml.user

# Rider / ReSharper
_ReSharper*/
*.ReSharper
*.DotSettings.user

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~